# Fully Governed — Environment Variables Reference
# Copy this file to .env and fill in real values.
# NEVER commit real secrets to version control.

# ── Supabase (required) ──────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# ── Stripe (add when Stripe account is approved) ─────────────────────────────
# Use pk_test_... for test mode, pk_live_... only for production.
# The secret key (STRIPE_SECRET_KEY) must ONLY be set in Supabase edge function env.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE

# ── Application URL (used by edge functions for redirect URLs) ───────────────
APP_URL=https://fullygoverned.co.uk

# ── Edge Function Secrets (set in Supabase Dashboard → Settings → Edge Functions) ──
# These are NEVER put in the frontend .env file:
# STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
# STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET
# RESEND_API_KEY=re_YOUR_RESEND_KEY
# EMAIL_FROM_ADDRESS=bookings@fullygoverned.co.uk
# EMAIL_FROM_NAME=Fully Governed Studio
# SUPABASE_SERVICE_ROLE_KEY=eyJ...  (already available in edge function env)

# ── Vercel Production Env ────────────────────────────────────────────────────
# Set these in Vercel Project Settings → Environment Variables:
# VITE_SUPABASE_URL
# VITE_SUPABASE_PUBLISHABLE_KEY
# VITE_SUPABASE_PROJECT_ID
# VITE_STRIPE_PUBLISHABLE_KEY
# APP_URL
